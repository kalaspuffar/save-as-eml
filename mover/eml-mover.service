# eml-mover — systemd user service for the Save Message as EML mover.
#
# Install (adjust the path if the repo is not at ~/save-as-eml):
#   mkdir -p ~/.config/systemd/user
#   cp save-as-eml/mover/eml-mover.service ~/.config/systemd/user/
#   sed -i "s|__HOME__|$(echo ~)|" ~/.config/systemd/user/eml-mover.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now eml-mover
#
# Logs:
#   journalctl --user -u eml-mover -f

[Unit]
Description=Save Message as EML — move extension downloads to the output directory
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 __HOME__/save-as-eml/mover/eml_mover.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
